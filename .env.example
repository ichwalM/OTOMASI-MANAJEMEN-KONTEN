# ==============================================================================
# INTEGRASI WORDPRESS + HERMES AGENT + 9ROUTER
# ==============================================================================

# --- Port Services (Sesuai Konfigurasi Anda) ---
WP_PORT=10000
ROUTER_PORT=11000

# --- Database MariaDB ---
DB_NAME=wordpress
DB_USER=wpuser
DB_PASSWORD=wppassword123
DB_ROOT_PASSWORD=mariadb_root_secret

# --- WordPress CMS Configuration ---
WP_URL=http://localhost:10000
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=adminsecretpassword
WP_ADMIN_EMAIL=admin@example.com
WP_SITE_TITLE="Portal AI Hermes"

# --- WordPress REST API Application Password ---
# Dihasilkan otomatis saat menjalankan ./setup.sh, atau dibuat manual di wp-admin:
# Users -> Profile -> Application Passwords
WP_APP_PASSWORD=

# --- 9Router & AI LLM Gateway Configuration ---
# 9Router bertindak sebagai proxy OpenAI-compatible pada port 11000
# Password default dashboard login 9Router (bisa diubah sesuai keinginan):
ROUTER_PASSWORD=admin123456
OPENAI_API_KEY=9router
HERMES_MODEL=gemini-2.5-flash

# --- Telegram Bot Gateway Configuration ---
# Dapatkan Token dari Telegram @BotFather via perintah /newbot
TELEGRAM_BOT_TOKEN=
# Dapatkan Numeric User ID dari bot Telegram @userinfobot (contoh: 123456789)
TELEGRAM_ALLOWED_USERS=
